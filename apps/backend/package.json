{
  "name": "backend",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply ads_platform_db --local",
    "db:migrate:prod": "wrangler d1 migrations apply ads_platform_db --remote",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ads-platform/shared": "workspace:*",
    "@hono/zod-validator": "^0.4.3",
    "bcryptjs": "^3.0.2",
    "drizzle-orm": "^0.40.0",
    "hono": "^4.12.31",
    "jose": "^6.0.11",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.1",
    "@cloudflare/workers-types": "^4.20250224.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.13.10",
    "better-sqlite3": "^13.0.2",
    "drizzle-kit": "^0.30.5",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.110.0"
  }
}