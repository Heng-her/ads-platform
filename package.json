{
  "name": "new-platform",
  "private": true,
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "dev": "pnpm -r dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "dev:backend": "pnpm --filter backend dev",
    "build": "pnpm -r build",
    "deploy:frontend": "pnpm --filter frontend build && pnpm --filter frontend run deploy",
    "deploy:backend": "pnpm --filter backend run deploy",
    "deploy:all": "pnpm deploy:backend && pnpm deploy:frontend",
    "lint": "pnpm -r lint"
  },
  "pnpm": {
    "overrides": {
      "drizzle-orm": "^0.40.0"
    },
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/server-renderer": "^3.5.40",
    "@vue/test-utils": "^2.4.11",
    "happy-dom": "^20.11.1",
    "vitest": "^4.1.10"
  }
}
