{
  "name": "new-platform",
  "private": true,
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "dev": "pnpm -r dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "dev:backend": "pnpm --filter backend dev",
    "build": "pnpm -r build",
    "deploy:frontend": "pnpm --filter frontend build && pnpm --filter frontend run deploy",
    "deploy:backend": "pnpm --filter backend run deploy",
    "deploy:all": "pnpm deploy:backend && pnpm deploy:frontend",
    "lint": "pnpm -r lint",
    "migration": "pnpm --filter backend db:migrate:local",
    "db:generate": "pnpm --filter backend db:generate",
    "db:migrate": "pnpm --filter backend db:migrate:local",
    "db:migrate:local": "pnpm --filter backend db:migrate:local",
    "db:migrate:prod": "pnpm --filter backend db:migrate:prod",
    "db:seed:local": "pnpm --filter backend db:seed:local",
    "db:seed:prod": "pnpm --filter backend db:seed:prod",
    "db:seed:articles": "pnpm --filter backend db:seed:articles:local",
    "db:clean:articles": "pnpm --filter backend db:clean:articles:local",
    "db:seed:articles:prod": "pnpm --filter backend db:seed:articles:prod",
    "db:clean:articles:prod": "pnpm --filter backend db:clean:articles:prod",
    "db:setup": "pnpm --filter backend db:migrate:local && pnpm --filter backend db:seed:local"
  },
  "pnpm": {
    "overrides": {
      "drizzle-orm": "^0.40.0"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/server-renderer": "^3.5.40",
    "@vue/test-utils": "^2.4.11",
    "happy-dom": "^20.11.1",
    "vitest": "^4.1.10"
  }
}
